# Generated by the Customer Install Kit (RC1-640) from the v1 profile
# (ADR 0001). Regenerated on every install; edit install.toml, not this.
app = "{app}"
primary_region = "{region}"

[env]
  ESP_ENVIRONMENT = "production"
  ESP_PUBLIC_URL = "{public_url}"

[mounts]
  source = "{volume}"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "suspend"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"
    method = "GET"
    path = "/healthz"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
